#include <zephyr/dt-bindings/led/led.h>
#include <zephyr/dt-bindings/pinctrl/esp32-pinctrl.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	aliases {
		led-strip = &strip0;
	};

	dht22: dht22 {
		compatible = "aosong,dht";
		dio-gpios = <&gpio0 26 (GPIO_ACTIVE_LOW | GPIO_OPEN_DRAIN)>;
		dht22;
		status = "okay";
	};

	/* Solar panel input voltage: J2 / IO35, ADC1 ch7.
	 * Physical divider: R_bottom = 10kΩ, R_top = 100kΩ → ratio 11.0×.
	 * Note: readings may not match multimeter due to resistor tolerances and
	 * ESP32 ADC non-linearity. Recalibrate full-ohms against a known voltage if needed. */
	vsolar: vsolar {
		compatible = "voltage-divider";
		io-channels = <&adc0 7>;
		output-ohms = <10000>;
		full-ohms = <110000>;
		skip-calibration;
		status = "okay";
	};

	/* Battery voltage: J3 / IO34, ADC1 ch6.
	 * Physical divider: R_bottom = 10kΩ, R_top = 47kΩ → ratio 5.7×. */
	vbatt: vbatt {
		compatible = "voltage-divider";
		io-channels = <&adc0 6>;
		output-ohms = <10000>;
		full-ohms = <57000>;
		skip-calibration;
		status = "okay";
	};

	/* Pwr 3 (J16) — N-channel MOSFET low-side switch on IO32 (gpio1 pin 0).
	 * Exposed as a regulator so it is controllable from the shell:
	 *   regulator enable pwr3
	 *   regulator disable pwr3 */
	pwr3: pwr3 {
		compatible = "regulator-fixed";
		regulator-name = "pwr3";
		enable-gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};

&i2s0_default {
	group1 {
		pinmux = <I2S0_O_WS_GPIO16>,
			 <I2S0_O_BCK_GPIO4>,
			 <I2S0_O_SD_GPIO2>,
			 <I2S0_I_SD_GPIO17>;
	};
};

&i2s0 {
	status = "okay";

	strip0: ws2812@0 {
		compatible = "worldsemi,ws2812-i2s";
		reg = <0>;
		chain-length = <1>;
		color-mapping = <LED_COLOR_ID_GREEN
				 LED_COLOR_ID_RED
				 LED_COLOR_ID_BLUE>;
		reset-delay = <500>;
	};
};

&adc0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* Solar Panel Voltage: J2 Header -> IO35 (ADC1 Channel 7)
	 * Referenced by vsolar voltage-divider node. */
	channel@7 {
		reg = <7>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};

	/* Battery Voltage: J3 Header -> IO34 (ADC1 Channel 6)
	 * Referenced by vbatt voltage-divider node. */
	channel@6 {
		reg = <6>;
		zephyr,gain = "ADC_GAIN_1_4";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};