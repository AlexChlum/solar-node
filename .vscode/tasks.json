{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Zephyr: Build ESP32 ProCPU (standard)",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": ["-m", "west", "build", "-b", "esp32_devkitc/esp32/procpu", "."],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {"PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}"}
			},
			"group": {"kind": "build", "isDefault": true},
			"problemMatcher": []
		},
		{
			"label": "Zephyr: Build ESP32 ProCPU (pristine)",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": ["-m", "west", "build", "-p", "-b", "esp32_devkitc/esp32/procpu", "."],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {"PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}"}
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Zephyr: Flash ESP32 ProCPU",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": ["-m", "west", "flash", "--build-dir", "build"],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {"PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}"}
			},
			"problemMatcher": []
		},
		{
			"label": "Zephyr: Monitor Serial (COM5 115200)",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": ["-m", "serial.tools.miniterm", "COM5", "115200"],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {"PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}"}
			},
			"presentation": {"echo": true, "reveal": "always", "focus": true, "panel": "new"},
			"problemMatcher": []
		},
		{
			"label": "Zephyr: Flash and Connect ESP32 ProCPU",
			"dependsOrder": "sequence",
			"dependsOn": [
				"Zephyr: Flash ESP32 ProCPU",
				"Zephyr: Monitor Serial (COM5 115200)"
			],
			"problemMatcher": []
		},
		{
			"label": "Zephyr: Build OTA ESP32 ProCPU (pristine)",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": ["-m", "west", "build", "-p", "--sysbuild", "-b", "esp32_devkitc/esp32/procpu", "."],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {"PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}"}
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Zephyr: Flash OTA ESP32 ProCPU",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": ["-m", "west", "flash", "--build-dir", "build"],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {"PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}"}
			},
			"problemMatcher": []
		},
		{
			"label": "OTA: Upload, Test, and Reset",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": [
				"scripts\\ota.py",
				"--ip",
				"${input:otaIp}",
				"upload-test-reset",
				"${workspaceFolder}\\build\\solar-node\\zephyr\\zephyr.signed.bin"
			],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {"PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}"}
			},
			"problemMatcher": []
		},
		{
			"label": "OTA: Confirm Active Image",
			"type": "shell",
			"command": ".\\.venv\\Scripts\\python.exe",
			"args": ["scripts\\ota.py", "--ip", "${input:otaIp}", "confirm-current"],
			"options": {
				"cwd": "${workspaceFolder}",
				"env": {"PATH": "${workspaceFolder}\\.venv\\Scripts;${env:PATH}"}
			},
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "otaIp",
			"type": "promptString",
			"description": "Solar Node IPv4 address",
			"default": "192.168.1.177"
		}
	]
}
